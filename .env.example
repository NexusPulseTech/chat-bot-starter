# Copy this file to .env and fill in what you use.
# A channel is enabled as soon as one of its variables is set,
# and then all of its variables are required.

PORT=3000

# Where conversations, orders and settings are stored.
# In Docker this is /app/data/bot.db, on a volume.
DATABASE_PATH=./data/bot.db

# Times in the dashboard and in exported files.
TIMEZONE=Asia/Ho_Chi_Minh

# ---------------------------------------------------------------------------
# Channels
# ---------------------------------------------------------------------------

# Facebook Messenger
# Meta for Developers > your app > Messenger > Settings
MESSENGER_APP_SECRET=
MESSENGER_PAGE_ACCESS_TOKEN=
# Any string you choose. Type the same value into the webhook form.
MESSENGER_VERIFY_TOKEN=

# Zalo Official Account
# developers.zalo.me > your app > Official Account
ZALO_APP_ID=
ZALO_OA_SECRET_KEY=
ZALO_OA_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Dashboard at /admin
# ---------------------------------------------------------------------------

# Setting a password turns the dashboard on. At least 12 characters.
ADMIN_PASSWORD=
# Marks the login cookie Secure. Defaults to true when NODE_ENV=production.
# Serve the dashboard over HTTPS in production.
COOKIE_SECURE=
# Set to true only behind a reverse proxy you control (Nginx, Caddy,
# Cloudflare), so login rate limiting sees the real client address.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# AI replies (optional)
# ---------------------------------------------------------------------------

# From console.anthropic.com. Without it, the bot answers from keyword rules.
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5. Any Claude model id works.
AI_MODEL=
# low, medium or high. Higher effort costs more and answers more slowly.
AI_EFFORT=low

# ---------------------------------------------------------------------------
# External workflow (optional)
# ---------------------------------------------------------------------------

# Send each message to a workflow, for example an n8n Webhook node, instead of
# the built-in rules and AI. The endpoint answers {"reply": "..."}.
# Ordering and asking for a person are still handled by the bot.
FORWARD_URL=
FORWARD_TOKEN=
