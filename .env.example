# Copy this file to .env and fill in the channels you use.
# A channel is enabled as soon as one of its variables is set,
# and then all of its variables are required.

PORT=3000

# Facebook Messenger
# Meta for Developers > your app > Messenger > Settings
MESSENGER_APP_SECRET=
MESSENGER_PAGE_ACCESS_TOKEN=
# Any string you choose. Type the same value into the webhook form.
MESSENGER_VERIFY_TOKEN=

# Zalo Official Account
# developers.zalo.me > your app > Official Account
ZALO_APP_ID=
ZALO_OA_SECRET_KEY=
ZALO_OA_ACCESS_TOKEN=

# Optional: send every message to a workflow instead of the built-in rules,
# for example an n8n Webhook node. The endpoint answers {"reply": "..."}.
FORWARD_URL=
FORWARD_TOKEN=
